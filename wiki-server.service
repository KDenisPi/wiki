# The wiki question service (agent/wiki_service.py) - the backend AI_agents'
# MCP proxy at :8000/wiki and the kiosk call.
#
# Install:
#   sudo cp wiki-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now wiki-server
#   journalctl -u wiki-server -f
#
# Adjust User/WorkingDirectory/ExecStart if the checkout, the venv or the
# database live elsewhere (the database path is the pipeline's --db default;
# pass --db after the script to change it).

[Unit]
Description=Wiki question service (agent/wiki_service.py)
# Ollama answers step 0 and stage 1; it is reached per request, so it is only
# ordered before this, not required. The llama-server on :1235 is asked only
# when the composer cannot build a query.
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=denis
WorkingDirectory=/home/denis/projects/wiki
ExecStart=/home/denis/projects/venv-duckdb2/bin/python /home/denis/projects/wiki/agent/wiki_service.py --port 8200
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
